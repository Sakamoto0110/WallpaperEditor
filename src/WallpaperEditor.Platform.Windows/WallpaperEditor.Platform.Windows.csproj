<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      IDesktopWallpaper needs Windows 8, and .NET 10 itself needs Windows 10, so the requirement always
      holds. A versioned target framework would satisfy the analyzer, but it also pulls in the whole
      WinRT projection, which this assembly does not use.
    -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallpaperEditor.Core\WallpaperEditor.Core.csproj" />
  </ItemGroup>

</Project>
