<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the companion's icon in the notification area, which WPF does not have. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\neko-purple-light.ico</ApplicationIcon>
    <RootNamespace>WallpaperEditor.App</RootNamespace>
    <!-- ThemeMode, the Fluent theme, is still marked as experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\neko-purple-light.ico" />
  </ItemGroup>

  <!-- WPF types keep their plain names; the one file that needs Windows Forms says so. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallpaperEditor.Core\WallpaperEditor.Core.csproj" />
    <ProjectReference Include="..\WallpaperEditor.Platform.Windows\WallpaperEditor.Platform.Windows.csproj" />
    <ProjectReference Include="..\WallpaperEditor.Rendering\WallpaperEditor.Rendering.csproj" />
  </ItemGroup>

</Project>
