<Window x:Class="WallpaperEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WallpaperEditor.App.ViewModels"
        xmlns:views="clr-namespace:WallpaperEditor.App.Views"
        Title="WallpaperEditor"
        AutomationProperties.Name="WallpaperEditor"
        Width="1180"
        Height="840"
        MinWidth="860"
        MinHeight="600"
        Icon="assets/neko-purple-light.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:MonitorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorViewModel}">
            <views:EditorView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding Current}" />
</Window>
