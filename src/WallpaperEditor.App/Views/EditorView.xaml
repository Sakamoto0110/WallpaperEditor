<UserControl x:Class="WallpaperEditor.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WallpaperEditor.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Project and publishing -->
        <Grid DockPanel.Dock="Top" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding BackCommand}" Content="Monitores" />
                <TextBlock Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Heading}"
                           Text="{Binding ProjectName}"
                           ToolTip="{Binding ProjectPath}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Opacity="0.85"
                           Text="{Binding PublishState}" />
                <ComboBox MinWidth="200"
                          AutomationProperties.Name="Monitor"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding Monitors}"
                          SelectedItem="{Binding PublishMonitor}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding PublishCommand}"
                        Content="Publicar"
                        Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock DockPanel.Dock="Bottom"
                   Margin="12,6,12,10"
                   Text="{Binding Status}"
                   TextWrapping="Wrap" />

        <!-- Inspector and history -->
        <TabControl DockPanel.Dock="Right"
                    Width="340"
                    Margin="0,0,8,0">
            <TabItem Header="Editar">
                <ScrollViewer Padding="4,8,12,8" VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding IsEditable}">
                    <TextBlock Style="{StaticResource Heading}" Text="Adicionar" />
                    <UniformGrid Margin="0,6,0,0" Columns="2">
                        <Button Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding AddImageCommand}"
                                Content="Imagem..." />
                        <Button Margin="4,0,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding AddChecklistCommand}"
                                Content="Checklist" />
                    </UniformGrid>

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource Heading}"
                               Text="Fundo" />
                    <TextBlock Margin="0,2,0,6"
                               Opacity="0.75"
                               FontSize="12"
                               Text="{Binding BackgroundName}"
                               TextTrimming="CharacterEllipsis" />
                    <UniformGrid Columns="2">
                        <Button Margin="0,0,4,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ChangeBackgroundCommand}"
                                Content="Trocar..." />
                        <ComboBox Margin="4,0,0,0"
                                  HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Ajuste do fundo"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding FitOptions}"
                                  SelectedValue="{Binding BackgroundFit}"
                                  SelectedValuePath="Mode" />
                    </UniformGrid>

                    <TextBlock Margin="0,16,0,6"
                               Style="{StaticResource Heading}"
                               Text="Itens" />
                    <ListBox MaxHeight="130"
                             AutomationProperties.Name="Itens"
                             DisplayMemberPath="Label"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedRow}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                <Setter Property="Padding" Value="8,3" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Selected item -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Heading}" Text="Item selecionado" />

                        <UniformGrid Margin="0,6,0,0" Columns="3">
                            <Button Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding BringForwardCommand}"
                                    Content="Subir" />
                            <Button Margin="2,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SendBackwardCommand}"
                                    Content="Descer" />
                            <Button Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding RemoveSelectedCommand}"
                                    Content="Remover" />
                        </UniformGrid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="X" />
                                <TextBox AutomationProperties.Name="X" Text="{Binding ItemX}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Caption}" Text="Y" />
                                <TextBox AutomationProperties.Name="Y" Text="{Binding ItemY}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Style="{StaticResource Caption}" Text="Largura" />
                                <TextBox AutomationProperties.Name="Largura" Text="{Binding ItemWidth}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Style="{StaticResource Caption}" Text="Altura" />
                                <TextBox AutomationProperties.Name="Altura" Text="{Binding ItemHeight}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource Caption}" Text="Rotação (graus)" />
                                <TextBox AutomationProperties.Name="Rotação" Text="{Binding ItemRotation}" />
                            </StackPanel>
                        </Grid>

                        <!-- Image -->
                        <StackPanel Visibility="{Binding IsImageSelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Caption}" Text="Opacidade" />
                            <Slider AutomationProperties.Name="Opacidade"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="{Binding ItemOpacity, Delay=300}" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding RealSizeCommand}"
                                    Content="Tamanho real (100%)" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="12"
                                       Opacity="0.85"
                                       Text="{Binding ScaleNote}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Checklist -->
                        <StackPanel Visibility="{Binding IsChecklistSelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Caption}" Text="Título" />
                            <TextBox AutomationProperties.Name="Título" Text="{Binding ChecklistTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Tamanho do texto" />
                            <TextBox AutomationProperties.Name="Tamanho do texto" Text="{Binding ChecklistFontSize}" />

                            <TextBlock Style="{StaticResource Caption}" Text="Tarefas" />
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox MinWidth="0"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Text}"
                                                      IsChecked="{Binding Done}" />
                                            <TextBox Grid.Column="1"
                                                     Margin="4,0"
                                                     AutomationProperties.Name="Texto da tarefa"
                                                     Text="{Binding Text}" />
                                            <Button Grid.Column="2"
                                                    AutomationProperties.Name="Remover tarefa"
                                                    Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="×" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="Nova tarefa"
                                         Text="{Binding NewEntryText, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddEntryCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Margin="4,0,0,0"
                                        Command="{Binding AddEntryCommand}"
                                        Content="Adicionar" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Histórico">
                <Grid Margin="4,8,4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <ListBox AutomationProperties.Name="Histórico"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding History}"
                         SelectedItem="{Binding SelectedHistory}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11"
                                               Opacity="0.7"
                                               Text="{Binding Number, StringFormat='Revisão {0}'}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="11"
                                               Opacity="0.7"
                                               Text="{Binding When}" />
                                    <TextBlock Margin="8,0,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="atual"
                                               Visibility="{Binding IsHead, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <UniformGrid Grid.Row="1" Margin="0,6,0,0" Columns="2">
                    <Button Margin="0,0,4,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding RevertCommand}"
                            Content="Voltar a esta" />
                    <Button Margin="4,0,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding RestoreRemovedItemCommand}"
                            Content="Restaurar item" />
                </UniformGrid>
                <Image Grid.Row="2"
                       Margin="0,8,0,0"
                       MaxHeight="170"
                       AutomationProperties.Name="Miniatura da revisão"
                       HorizontalAlignment="Center"
                       Source="{Binding HistoryThumbnail}" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Canvas -->
        <views:EditorSurface x:Name="Surface" AutomationProperties.Name="Área de edição" />
    </DockPanel>
</UserControl>
