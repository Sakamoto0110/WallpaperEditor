<UserControl x:Class="WallpaperEditor.App.Views.MonitorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="Accent" Color="#A4779A" />

        <Style x:Key="MonitorItem" TargetType="ListBoxItem">
            <Setter Property="Canvas.Left" Value="{Binding MapLeft}" />
            <Setter Property="Canvas.Top" Value="{Binding MapTop}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Info.Name}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Details}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame"
                                Width="{Binding MapWidth}"
                                Height="{Binding MapHeight}"
                                Background="#222"
                                BorderBrush="#555"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#999" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Command="{Binding RefreshCommand}"
                    Content="Atualizar" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Escolha um monitor" />
        </DockPanel>

        <ListBox Grid.Row="1"
                 Height="176"
                 Padding="0"
                 HorizontalAlignment="Center"
                 AutomationProperties.Name="Monitores"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource MonitorItem}"
                 ItemsSource="{Binding Monitors}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectedItem="{Binding SelectedMonitor}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Width="{Binding DataContext.MapWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Height="{Binding DataContext.MapHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom"
                                Padding="6,2"
                                Background="#B0000000">
                            <StackPanel>
                                <TextBlock Foreground="White"
                                           FontWeight="SemiBold"
                                           Text="{Binding Info.Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="#DDD"
                                           FontSize="11"
                                           Text="{Binding Resolution}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,18,0,0" MaxWidth="900">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Width="{Binding PreviewWidth}"
                    Height="{Binding PreviewHeight}"
                    Background="Black"
                    BorderBrush="#555"
                    BorderThickness="1">
                <Grid>
                    <Image AutomationProperties.Name="Pré-visualização"
                           Source="{Binding Preview}"
                           Stretch="Fill" />
                    <TextBlock Margin="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#EEE"
                               Text="{Binding PreviewError}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedMonitor.Info.Name}" />
                <TextBlock Margin="0,0,0,14"
                           Opacity="0.75"
                           Text="{Binding SelectedMonitor.Details}" />

                <TextBlock Margin="0,0,0,4" Text="Imagem" />
                <Button HorizontalAlignment="Stretch"
                        Command="{Binding ChooseImageCommand}"
                        Content="Escolher imagem..." />
                <TextBlock Margin="0,4,0,14"
                           Opacity="0.75"
                           FontSize="12"
                           Text="{Binding SelectedMonitor.SourcePath, FallbackValue='', TargetNullValue='Nenhuma imagem escolhida'}"
                           ToolTip="{Binding SelectedMonitor.SourcePath}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Margin="0,0,0,4" Text="Ajuste" />
                <ComboBox Margin="0,0,0,18"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Ajuste"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding FitOptions}"
                          SelectedValue="{Binding SelectedMonitor.Fit}"
                          SelectedValuePath="Mode" />

                <Button HorizontalAlignment="Stretch"
                        Command="{Binding ApplyCommand}"
                        Content="Aplicar neste monitor"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding RestoreCommand}"
                        Content="Restaurar wallpaper original" />

                <TextBlock Margin="0,22,0,6"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="Wallpaper dinâmico" />
                <TextBlock Margin="0,0,0,8"
                           Opacity="0.75"
                           FontSize="12"
                           Text="Uma composição de imagens e checklists que continua editável."
                           TextWrapping="Wrap" />
                <UniformGrid Columns="2">
                    <Button Margin="0,0,4,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding NewProjectCommand}"
                            Content="Novo projeto..." />
                    <Button Margin="4,0,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenProjectCommand}"
                            Content="Abrir projeto..." />
                </UniformGrid>
                <Button Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding EditMonitorProjectCommand}"
                        Content="{Binding SelectedMonitor.ProjectButtonLabel}"
                        Visibility="{Binding SelectedMonitor.HasProject, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Margin="0,0,0,4"
                       Foreground="#D9A441"
                       Text="{Binding Warning}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
