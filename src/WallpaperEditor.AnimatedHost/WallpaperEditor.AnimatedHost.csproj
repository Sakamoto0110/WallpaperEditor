<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console window: this process sits behind the desktop icons. It logs to a file instead. -->
    <OutputType>WinExe</OutputType>
    <!-- The only project with a versioned target framework: MediaPlayer is a WinRT API. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- SetWindowLongPtr only exists on 64-bit, and the experiment only runs here. -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.369">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WallpaperEditor.Core\WallpaperEditor.Core.csproj" />
    <ProjectReference Include="..\WallpaperEditor.Platform.Windows\WallpaperEditor.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
